# Codex command rules for repository-wide safety policy.
# Natural-language policy lives in AGENTS.md; this file only controls commands.

prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "Never remove the filesystem root.",
    match = ["rm -rf /"],
)

prefix_rule(
    pattern = ["rm", "-fr", "/"],
    decision = "forbidden",
    justification = "Never remove the filesystem root.",
    match = ["rm -fr /"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Investigate and preserve user work instead of discarding the tree.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "checkout", "--", "."],
    decision = "forbidden",
    justification = "Do not discard the working tree as a shortcut.",
    match = ["git checkout -- ."],
)

# Branch-aware enforcement (allow --force-with-lease on short-lived branches,
# block every force variant on main/master, resolve the real target branch,
# avoid false positives like "fix/main-x") lives in .codex/hooks/bash-guard.sh.
# prefix_rule only matches argv prefixes, so these are a coarse defense-in-depth
# layer covering the most common argument orders only.

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Bare --force is never allowed; use --force-with-lease on short-lived branches.",
    match = ["git push --force", "git push --force origin feature"],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Bare -f force-push is never allowed; use --force-with-lease.",
    match = ["git push -f", "git push -f origin feature"],
)

prefix_rule(
    pattern = ["git", "push", "origin", "main", "--force"],
    decision = "forbidden",
    justification = "Never force-push the default branch (main), even with --force-with-lease.",
    match = ["git push origin main --force"],
)

prefix_rule(
    pattern = ["git", "push", "origin", "main", "--force-with-lease"],
    decision = "forbidden",
    justification = "Never force-push the default branch (main), even with --force-with-lease.",
    match = ["git push origin main --force-with-lease"],
)

prefix_rule(
    pattern = ["git", "push", "origin", "master", "--force"],
    decision = "forbidden",
    justification = "Never force-push the default branch (master), even with --force-with-lease.",
    match = ["git push origin master --force"],
)

prefix_rule(
    pattern = ["git", "push", "origin", "master", "--force-with-lease"],
    decision = "forbidden",
    justification = "Never force-push the default branch (master), even with --force-with-lease.",
    match = ["git push origin master --force-with-lease"],
)
